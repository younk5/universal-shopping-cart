rules_version = '2';

// Cole isto em: Firebase Console > Firestore Database > Regras.
//
// Garante que cada usuário autenticado só consegue ler/escrever
// o próprio documento (users/{uid}/data/wishlist), nunca o de outra pessoa.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/data/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Mapa "nome de usuário -> e-mail", usado para permitir login por
    // usuário. "get" (buscar 1 doc pelo ID) é público, necessário ANTES do
    // login pra descobrir o e-mail correspondente a um usuário específico.
    // "list" fica bloqueado de propósito: sem isso, qualquer pessoa não
    // autenticada poderia listar a coleção inteira e vazar todos os
    // e-mails cadastrados. Só o dono (uid batendo) pode criar/alterar.
    //
    // Mesmo com "list" bloqueado, um "get" de um username específico já
    // devolve o e-mail associado — ver "Limitação conhecida" no README
    // pra entender o trade-off e o que fazer se isso virar um problema.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }
  }
}
