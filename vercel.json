{
  "functions": {
    "api/preview.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(favicon.ico|favicon-16x16.png|favicon-32x32.png|apple-touch-icon.png|og-image.webp|site.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(style.css|app.js|firebase.js|firebase-config.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
